NODE_ENV=development
HOST=127.0.0.1
# Local development port. Production uses 4183: deploy/compose.yml sets PORT and overrides this value.
PORT=4173
HAKU_PUBLIC_ORIGIN=http://localhost:4173
HAKU_ALLOWED_ORIGINS=http://localhost:4173
HAKU_COOKIE_SAMESITE=lax
HAKU_TRUSTED_PROXY=false
HAKU_SESSION_SECRET=replace-with-at-least-32-random-characters-before-start
# Optional legacy migration password only; ignored after any named admin exists.
HAKU_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
HAKU_DB_PATH=./data/haku.sqlite
HAKU_CONSENT_VERSION=2026-10-27-v1
HAKU_RETENTION_DAYS=365
HAKU_STATS_TIMEZONE=Asia/Phnom_Penh
HAKU_MAX_AUTH_AGE_SECONDS=600
# Telegram Bot API base; normally leave this at Telegram's official API.
HAKU_TELEGRAM_API_BASE=https://api.telegram.org
HAKU_BOTS_JSON='[{"id":"main","name":"Haku Main","handle":"@replace_me","token":"123456:replace-with-real-bot-token","role":"Mini App · English / 中文","active":true},{"id":"khmer","name":"Haku Khmer","handle":"@replace_me","token":"123456:replace-with-real-bot-token","role":"Mini App · Khmer","active":true},{"id":"thai","name":"Haku Thai","handle":"@replace_me","token":"123456:replace-with-real-bot-token","role":"Mini App · Thai","active":true}]'
